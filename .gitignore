tabnotes-e2e-*/
*-profile/
chrome-profile*/
user-data-dir*/
screenshots/
*.log
coverage/

# Local environment and secrets
.env
.env.*

# Editor / OS / tool files
.vscode/
.idea/
.claude/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
